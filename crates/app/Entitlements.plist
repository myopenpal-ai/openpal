<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Applied when the bundler code-signs the app under the hardened runtime
     (`codesign --options runtime --entitlements …`). The audio-input entitlement
     is required for microphone access (Voice add-on / voice typing) to work in a
     hardened, notarized build. -->
<plist version="1.0">
  <dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
