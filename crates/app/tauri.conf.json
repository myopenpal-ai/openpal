{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenPal",
  "mainBinaryName": "openpal",
  "identifier": "com.myopenpal.openpal",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenPal",
        "width": 1100,
        "height": 740,
        "minWidth": 900,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/llama/": "llama/",
      "resources/plugins/": "plugins/"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://github.com/myopenpal-ai/openpal/releases/latest/download/latest.json"
      ]
    },
    "engineUpdater": {
      "endpoint": "https://github.com/myopenpal-ai/openpal/releases/download/engine-latest/engine-manifest.json"
    }
  }
}
